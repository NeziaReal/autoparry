                    end)
                end
                return Count * 26
            end

            Interact.MouseButton1Click:Connect(function()
                Open = not Open
                local h = RefreshList()
                if Open then
                    TweenService:Create(Container, TweenInfo.new(0.2), { Size = UDim2.new(0, 140, 0, h) }):Play()
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 50 + h) }):Play()
                else
                    TweenService:Create(Container, TweenInfo.new(0.2), { Size = UDim2.new(0, 140, 0, 0) }):Play()
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 50) }):Play()
