                    Parent = Box,
                    Text = items[1] or "Select...",
                    Font = Enum.Font.Gotham,
                    TextColor3 = Theme.TextDark,
                    TextSize = 12,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 10, 0, 0),
                    Size = UDim2.new(1, -30, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 3
                })

                local Arrow = Create("TextLabel", {
                    Parent = Box,
                    Text = "v",
                    Font = Enum.Font.GothamBold,
                    TextColor3 = Theme.TextDark,
                    TextSize = 12,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -25, 0, 0),
                    Size = UDim2.new(0, 25, 1, 0),
                    ZIndex = 3
                })

                local ListFrame = Create("Frame", {
                    Parent = Box,
                    BackgroundColor3 = Theme.Main,
                    Position = UDim2.new(0, 0, 1, 5),
                    Size = UDim2.new(1, 0, 0, 0), -- Animated
                    Visible = false,
                    ZIndex = 5,
                    ClipsDescendants = true
                }, {
                    Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
                    Create("UIStroke", { Color = Theme.Stroke, Thickness = 1 })
                })
                
                local ListLayout = Create("UIListLayout", {
                    Parent = ListFrame,
                    SortOrder = Enum.SortOrder.LayoutOrder
                })

                local Open = false
                
                Box.MouseButton1Click:Connect(function()
                    Open = not Open
                    ListFrame.Visible = true
                    
                    local height = math.min(#items * 30, 150)
                    local targetSize = Open and UDim2.new(1, 0, 0, height) or UDim2.new(1, 0, 0, 0)
                    
                    TweenService:Create(ListFrame, TweenInfo.new(0.2), {Size = targetSize}):Play()
                    
                    if not Open then
                        task.wait(0.2)
                        ListFrame.Visible = false
                    end
                end)

                for _, item in pairs(items) do
                    local ItemBtn = Create("TextButton", {
                        Parent = ListFrame,
                        Text = item,
                        Font = Enum.Font.Gotham,
                        TextColor3 = Theme.TextDark,
                        TextSize = 12,
                        BackgroundColor3 = Theme.Main,
                        Size = UDim2.new(1, 0, 0, 30),
                        ZIndex = 6
                    })
                    
                    ItemBtn.MouseButton1Click:Connect(function()
                        SelectedText.Text = item
                        Open = false
                        TweenService:Create(ListFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                        task.wait(0.2)
                        ListFrame.Visible = false
                        pcall(callback, item)
                    end)
                end
            end

            return Elements
        end
        return TabObj
    end

    return WindowObj
end

