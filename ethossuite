-- Toggle Minimize
function Library:ToggleMinimize()
    self.Minimized = not self.Minimized
    
    if self.Minimized then
        Tween(self.MainFrame, {Size = UDim2.new(0, 800, 0, 40)}, 0.3)
    else
        Tween(self.MainFrame, {Size = UDim2.new(0, 800, 0, 600)}, 0.3)
    end
end

