            local function RefreshList()
                -- Clear old
                for _, v in pairs(Container:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
                
                -- Height calc
                local Count = 0
                for _, val in pairs(options.Values or {}) do
