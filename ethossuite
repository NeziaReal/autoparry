-- ═══════════════════════════════════════════════════════════════
-- UTILITY FUNCTIONS
-- ═══════════════════════════════════════════════════════════════

local function Create(className, properties)
    local instance = Instance.new(className)
    if properties then
        for prop, value in pairs(properties) do
            instance[prop] = value
        end
    end
    return instance
end

local function CreateCorner(parent, radius)
    local corner = Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 4),
        Parent = parent,
    })
    return corner
end

local function CreateStroke(parent, color, thickness)
    local stroke = Create("UIStroke", {
        Color = color or CONFIG.COLORS.BORDER,
        Thickness = thickness or 1,
        Parent = parent,
    })
    return stroke
end

local function CreatePadding(parent, padding)
    local pad = Create("UIPadding", {
        PaddingLeft = UDim.new(0, padding or CONFIG.PADDING.MEDIUM),
        PaddingRight = UDim.new(0, padding or CONFIG.PADDING.MEDIUM),
        PaddingTop = UDim.new(0, padding or CONFIG.PADDING.MEDIUM),
        PaddingBottom = UDim.new(0, padding or CONFIG.PADDING.MEDIUM),
        Parent = parent,
    })
    return pad
end

local function CreateListLayout(parent, padding, direction)
    local layout = Create("UIListLayout", {
        Padding = UDim.new(0, padding or CONFIG.PADDING.SMALL),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Direction = direction or Enum.FillDirection.Vertical,
        Parent = parent,
    })
    return layout
end

local function Tween(instance, properties, duration)
    local tweenInfo = TweenInfo.new(
        duration or CONFIG.TWEEN_INFO.Time,
        CONFIG.TWEEN_INFO.EasingStyle,
        CONFIG.TWEEN_INFO.EasingDirection
    )
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

