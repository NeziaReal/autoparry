            FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal)
        })
    end

    -- Value label positioned on the right side
    local ValueLabel = Create("TextLabel", {
        Parent = SliderFrame,
        Text = tostring(default),
        Font = UI_CONFIG.FontNumber,
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 40, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Right,
        FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
    })

    -- Slider track positioned on the right half
    local Track = Create("Frame", {
        Parent = SliderFrame,
        BackgroundColor3 = Library.Theme.Main,
        Position = UDim2.new(0.5, 10, 0, options.Description and 46 or 30),
        Size = UDim2.new(0.5, -55, 0, 5),
        ZIndex = 21
    }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    ApplyStroke(Track, Library.Theme.Stroke, 1)

    local Fill = Create("Frame", {
        Parent = Track,
        BackgroundColor3 = UI_CONFIG.Accent,
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        ZIndex = 22
    }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    local Knob = Create("Frame", {
        Parent = Track,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Size = UDim2.new(0, 16, 0, 16),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
        ZIndex = 23
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        ApplyStroke(nil, UI_CONFIG.Accent, 1.5)
    })

    local dragging = false
    local callbacks = {}
    local currentValue = default

    local function updateSlider(input)
        local percent = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * percent + 0.5)
        if value ~= currentValue then
            currentValue = value
            Fill.Size = UDim2.new(percent, 0, 1, 0)
            Knob.Position = UDim2.new(percent, 0, 0.5, 0)
            ValueLabel.Text = tostring(value)
            Library.Flags[flag] = value
            for _, cb in pairs(callbacks) do
                task.spawn(cb, value)
            end
        end
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)

    Track.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    Knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    Knob.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)

    local SliderObj = {
        Value = currentValue,
        OnChanged = function(self, callback)
            table.insert(callbacks, callback)
            return self
        end,
        SetValue = function(self, value)
            local clamped = math.clamp(value, min, max)
            local percent = (clamped - min) / (max - min)
            currentValue = clamped
            Fill.Size = UDim2.new(percent, 0, 1, 0)
            Knob.Position = UDim2.new(percent, 0, 0.5, 0)
            ValueLabel.Text = tostring(clamped)
            Library.Flags[flag] = clamped
            self.Value = clamped
        end
    }
    
    Library.Options[flag] = SliderObj
    SliderObj:OnChanged(callback)
    Create("UIPadding", { Parent = SliderFrame, PaddingBottom = UDim.new(0, 12) })
    return SliderObj
end

