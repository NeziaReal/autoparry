            -- Recalculate canvas size
            task.wait(0.1)
            SidebarContent.CanvasSize = UDim2.new(0, 0, 0, SidebarLayout.AbsoluteContentSize.Y + 20)
        end
        
        if tabConfig.HasChildren then
            ArrowLabel.Text = ICONS.DROPDOWN_RIGHT
            TabButton.MouseButton1Click:Connect(function()
                Tab:ToggleExpand()
            end)
        end
        
        return Tab
    end
    
    -- ═══════════════════════════════════════════════════════════
    -- TAB SELECTION
    -- ═══════════════════════════════════════════════════════════
    
    function Window:SelectTab(tab)
        if Window.ActiveTab == tab then return end
        
        -- Hide previous tab
        if Window.ActiveTab then
            Window.ActiveTab.Content.Visible = false
            Tween(Window.ActiveTab.Button, {BackgroundColor3 = CONFIG.COLORS.SIDEBAR_BG})
        end
        
        -- Show new tab
        Window.ActiveTab = tab
        tab.Content.Visible = true
        Tween(tab.Button, {BackgroundColor3 = CONFIG.COLORS.SIDEBAR_BG_HOVER})
        
        -- Update canvas size
        task.wait(0.05)
        ContentScroller.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 32)
    end
    
    -- ═══════════════════════════════════════════════════════════
    -- WINDOW CONTROLS
    -- ═══════════════════════════════════════════════════════════
    
    function Window:Show()
        MainFrame.Visible = true
        Tween(MainFrame, {Size = UDim2.new(0, CONFIG.WINDOW_WIDTH, 0, CONFIG.WINDOW_HEIGHT)}, 0.2)
    end
    
    function Window:Hide()
        Tween(MainFrame, {Size = UDim2.new(0, 0, 0, 0)}, 0.2).Completed:Wait()
        MainFrame.Visible = false
    end
    
    function Window:Destroy()
        ScreenGui:Destroy()
    end
    
    -- Initial canvas size update
    task.delay(0.1, function()
        SidebarContent.CanvasSize = UDim2.new(0, 0, 0, SidebarLayout.AbsoluteContentSize.Y + 20)
    end)
    
    return Window
end

