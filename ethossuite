                })

                local SelectedLabel = Create("TextLabel", {
                    Parent = DropBtn,
                    Text = default,
                    Font = Enum.Font.Gotham,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 10, 0, 0),
                    Size = UDim2.new(1, -30, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local Arrow = Create("TextLabel", {
                    Parent = DropBtn,
                    Text = "▼",
                    Font = Enum.Font.Gotham,
                    TextColor3 = Theme.TextDim,
                    TextSize = 10,
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.new(0, 10, 0, 10)
                })

                local OptionsFrame = Create("Frame", {
                    Parent = DropdownFrame,
                    BackgroundColor3 = Theme.Section,
                    Position = UDim2.new(0, 0, 0, 65),
                    Size = UDim2.new(1, 0, 0, 0),
                    Visible = false,
                    ZIndex = 30,
                    ClipsDescendants = true
                }, {
                    Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
                    ApplyStroke(nil, Theme.Stroke, 1),
                    Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
                    Create("UIPadding", { PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5) })
                })

                local expanded = false
                for _, option in ipairs(options) do
                    local OptionBtn = Create("TextButton", {
                        Parent = OptionsFrame,
                        BackgroundColor3 = Theme.Main,
                        Size = UDim2.new(1, -10, 0, 25),
                        Text = "",
                        ZIndex = 31
                    }, {
                        Create("UICorner", { CornerRadius = UDim.new(0, 4) })
                    })

                    local OptLabel = Create("TextLabel", {
                        Parent = OptionBtn,
                        Text = option,
                        Font = Enum.Font.Gotham,
                        TextColor3 = Theme.TextDim,
                        TextSize = 11,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, -10, 1, 0),
                        Position = UDim2.new(0, 10, 0, 0),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 32
                    })

                    OptionBtn.MouseButton1Click:Connect(function()
                        SelectedLabel.Text = option
                        Library.Flags[flag] = option
                        OptionsFrame.Visible = false
                        expanded = false
                        if callback then
                            Library.FlagCallbacks[flag] = callback
                            pcall(callback, option)
                        end
                    end)
                end

                DropBtn.MouseButton1Click:Connect(function()
                    expanded = not expanded
                    OptionsFrame.Visible = expanded
                    if expanded then
                        OptionsFrame.Size = UDim2.new(1, 0, 0, math.min(#options * 27 + 10, 150))
                    end
                end)
            end

            --// KEYBIND (Obsidian inspired)
            function Elements:CreateKeybind(text, desc, default, callback, flag)
                flag = flag or text
                default = default or Enum.KeyCode.Unknown
                Library.Flags[flag] = default
                
                local KeybindFrame = Create("Frame", {
                    Parent = Box,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    ZIndex = 20
                })

                local TitleLabel = Create("TextLabel", {
                    Parent = KeybindFrame,
                    Text = text,
                    Font = Enum.Font.GothamBold,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -80, 0, 16),
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local DescLabel = Create("TextLabel", {
                    Parent = KeybindFrame,
                    Text = desc or "",
                    Font = Enum.Font.Gotham,
                    TextColor3 = Theme.TextDim,
                    TextSize = 11,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 16),
                    Size = UDim2.new(1, -80, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true
                })
                
                AddHoverEffect(DescLabel, Theme.TextDim, Theme.TextHover)

                local KeyBtn = Create("TextButton", {
                    Parent = KeybindFrame,
                    BackgroundColor3 = Theme.Main,
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, 0, 0, 0),
                    Size = UDim2.new(0, 70, 0, 25),
                    Text = default.Name,
                    Font = Enum.Font.Gotham,
                    TextColor3 = Theme.Text,
                    TextSize = 11,
                    ZIndex = 21
                }, {
                    Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
                    ApplyStroke(nil, Theme.Stroke, 1)
                })

                local listening = false
                KeyBtn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true
                    KeyBtn.Text = "..."
                    
                    local connection
                    connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                        if not listening then connection:Disconnect() return end
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            Library.Flags[flag] = input.KeyCode
                            KeyBtn.Text = input.KeyCode.Name
                            listening = false
                            connection:Disconnect()
                        end
                    end)
                end)
                
                -- Listen for the keybind being pressed
                UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if gameProcessed then return end
                    if input.KeyCode == Library.Flags[flag] and callback then
                        pcall(callback)
                    end
                end)

                Create("UIPadding", { Parent = KeybindFrame, PaddingBottom = UDim.new(0, 6) })
            end

            --// BUTTON (Obsidian inspired)
            function Elements:CreateButton(text, desc, callback)
                local ButtonFrame = Create("TextButton", {
                    Parent = Box,
                    BackgroundColor3 = Theme.Main,
                    Size = UDim2.new(1, 0, 0, 35),
                    Text = "",
                    ZIndex = 20
                }, {
                    Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
                    ApplyStroke(nil, Theme.Stroke, 1)
                })

                Create("TextLabel", {
                    Parent = ButtonFrame,
                    Text = text,
                    Font = Enum.Font.GothamBold,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -20, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                ButtonFrame.MouseButton1Click:Connect(function()
                    TweenService:Create(ButtonFrame, TweenInfo.new(0.1), { BackgroundColor3 = UI_CONFIG.Accent }):Play()
                    task.wait(0.1)
                    TweenService:Create(ButtonFrame, TweenInfo.new(0.1), { BackgroundColor3 = Theme.Main }):Play()
                    if callback then pcall(callback) end
                end)
            end

            --// INPUT (Obsidian inspired)
            function Elements:CreateInput(text, desc, placeholder, callback, flag)
                flag = flag or text
                Library.Flags[flag] = ""
                
                local InputFrame = Create("Frame", {
                    Parent = Box,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    ZIndex = 20
                })

                Create("TextLabel", {
                    Parent = InputFrame,
                    Text = text,
                    Font = Enum.Font.GothamBold,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 16),
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local DescLabel = Create("TextLabel", {
                    Parent = InputFrame,
                    Text = desc or "",
                    Font = Enum.Font.Gotham,
                    TextColor3 = Theme.TextDim,
                    TextSize = 10,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 16),
                    Size = UDim2.new(1, 0, 0, 14),
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                AddHoverEffect(DescLabel, Theme.TextDim, Theme.TextHover)

                local InputBox = Create("TextBox", {
                    Parent = InputFrame,
                    BackgroundColor3 = Theme.Main,
                    Position = UDim2.new(0, 0, 0, 32),
                    Size = UDim2.new(1, 0, 0, 30),
                    Text = "",
                    PlaceholderText = placeholder or "Enter text...",
                    Font = Enum.Font.Gotham,
                    TextColor3 = Theme.Text,
                    PlaceholderColor3 = Theme.TextDim,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 21,
                    ClearTextOnFocus = false
                }, {
                    Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
                    ApplyStroke(nil, Theme.Stroke, 1),
                    Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
                })

                InputBox.FocusLost:Connect(function()
                    Library.Flags[flag] = InputBox.Text
                    if callback then
                        Library.FlagCallbacks[flag] = callback
                        pcall(callback, InputBox.Text)
                    end
                end)

                Create("UIPadding", { Parent = InputFrame, PaddingBottom = UDim.new(0, 6) })
            end

            return Elements
        end
        
        -- Aliases for Obsidian compatibility
        SectionFuncs.AddSection = SectionFuncs.CreateSection
        
        return SectionFuncs
    end
    
