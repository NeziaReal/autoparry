    local function CreateSidebarButton(text, isActive)
        local btnFrame = Create("Frame", {
            Parent = SidebarList,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 32),
        })
        
        -- Active Indicator
        local indicator = Create("Frame", {
            Parent = btnFrame,
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 6),
            Size = UDim2.new(0, isActive and 3 or 0, 0, 20),
        })
        
        Create("UICorner", {
            CornerRadius = UDim.new(0, 2),
            Parent = indicator,
        })
        
        -- Button
        local btn = Create("TextButton", {
            Parent = btnFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 15, 0, 0),
            Size = UDim2.new(1, -15, 1, 0),
            Font = Enum.Font.Gotham,
            Text = text,
            TextColor3 = Theme.TextWhite,
            TextTransparency = isActive and 0 or 0.5,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        
        btn.MouseButton1Click:Connect(function()
            if activeButton and activeButton ~= btnFrame then
                Tween(activeButton:FindFirstChild("Frame"), {Size = UDim2.new(0, 0, 0, 20)})
                Tween(activeButton:FindFirstChild("TextButton"), {TextTransparency = 0.5})
            end
            
            activeButton = btnFrame
            Tween(indicator, {Size = UDim2.new(0, 3, 0, 20)})
            Tween(btn, {TextTransparency = 0})
        end)
        
        btn.MouseEnter:Connect(function()
            if not isActive then
                Tween(btn, {TextTransparency = 0.2})
            end
        end)
        
        btn.MouseLeave:Connect(function()
            if activeButton ~= btnFrame then
                Tween(btn, {TextTransparency = 0.5})
            end
        end)
        
        if isActive then
            activeButton = btnFrame
        end
        
        return btnFrame
    end
    
