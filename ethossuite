--// EXECUTION LOGGER
local ExecutionLog = {}
local function InitExecutionLogger()
    local LogFolder = workspace:FindFirstChild("KitsuExecutionLogs")
    if not LogFolder then
        LogFolder = Instance.new("Folder")
        LogFolder.Name = "KitsuExecutionLogs"
        LogFolder.Parent = workspace
    end
    
    local LogValue = LogFolder:FindFirstChild("TotalExecutions")
    if not LogValue then
        LogValue = Instance.new("IntValue")
        LogValue.Name = "TotalExecutions"
        LogValue.Value = 0
        LogValue.Parent = LogFolder
    end
    
    LogValue.Value = LogValue.Value + 1
    
    local LogEntry = Instance.new("StringValue")
    LogEntry.Name = "Exec_" .. os.date("%Y%m%d_%H%M%S")
    LogEntry.Value = string.format("Execution #%d at %s", LogValue.Value, os.date("%c"))
    LogEntry.Parent = LogFolder
    
    ExecutionLog.Count = LogValue.Value
    ExecutionLog.Folder = LogFolder
    
    return LogValue.Value
end

