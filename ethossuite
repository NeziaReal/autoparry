-- NOTIFICATION SYSTEM
-- ═══════════════════════════════════════════════════════════════

function EthosUI:Notify(config)
    config = config or {}
    
    local NotificationGui = Create("ScreenGui", {
        Name = "EthosNotification",
        Parent = LocalPlayer:WaitForChild("PlayerGui"),
        ResetOnSpawn = false,
    })
    
    local NotificationFrame = Create("Frame", {
        Name = "Notification",
        Size = UDim2.new(0, 280, 0, 60),
        Position = UDim2.new(1, -300, 1, -80),
        BackgroundColor3 = CONFIG.COLORS.SIDEBAR_BG,
        BorderSizePixel = 0,
        Parent = NotificationGui,
    })
    CreateCorner(NotificationFrame, 6)
    
    local Title = Create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = config.Title or "Notification",
        TextColor3 = CONFIG.COLORS.TEXT_PRIMARY,
        TextSize = CONFIG.TEXT_SIZES.REGULAR,
        Font = CONFIG.FONTS.SUBTITLE,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = NotificationFrame,
    })
    
    local Message = Create("TextLabel", {
        Name = "Message",
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.new(0, 12, 0, 26),
        BackgroundTransparency = 1,
        Text = config.Message or "",
        TextColor3 = CONFIG.COLORS.TEXT_SECONDARY,
        TextSize = CONFIG.TEXT_SIZES.SMALL,
        Font = CONFIG.FONTS.SMALL,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = NotificationFrame,
    })
    
    -- Animate in
    NotificationFrame.Position = UDim2.new(1, 20, 1, -80)
    Tween(NotificationFrame, {Position = UDim2.new(1, -300, 1, -80)}, 0.3)
    
    -- Auto remove
    task.delay(config.Duration or 3, function()
        Tween(NotificationFrame, {Position = UDim2.new(1, 20, 1, -80)}, 0.3).Completed:Wait()
        NotificationGui:Destroy()
    end)
end

