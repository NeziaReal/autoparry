        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 201
    })

    -- Message (Also always 240,240,240)
    Create("TextLabel", {
        Parent = NotifFrame,
        Text = message,
        Font = UI_CONFIG.FontBody,
        TextColor3 = Theme.Text, -- Changed to always be visible
        TextSize = 11,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 24),
        Size = UDim2.new(1, -20, 0, 15),
