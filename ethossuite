local function CreateToggle(parent, name, description, default, callback)
    callback = callback or function() end
    local value = default or false
    
    local ToggleFrame = Create("Frame", {
        Name = name .. "Toggle",
        Size = UDim2.new(1, 0, 0, description and 45 or 28),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    
    -- Text Container
    local TextContainer = Create("Frame", {
        Name = "TextContainer",
        Size = UDim2.new(1, -40, 1, 0),
        BackgroundTransparency = 1,
        Parent = ToggleFrame,
    })
    
    Create("TextLabel", {
        Name = "Name",
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = CONFIG.COLORS.TEXT_PRIMARY,
        TextSize = CONFIG.TEXT_SIZES.REGULAR,
        Font = CONFIG.FONTS.REGULAR,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TextContainer,
    })
    
    if description then
        Create("TextLabel", {
            Name = "Description",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Position = UDim2.new(0, 0, 0, 18),
            BackgroundTransparency = 1,
            Text = description,
            TextColor3 = CONFIG.COLORS.TEXT_MUTED,
            TextSize = CONFIG.TEXT_SIZES.DESCRIPTION,
            Font = CONFIG.FONTS.SMALL,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Parent = TextContainer,
        })
    end
    
    -- Toggle Button
    local ToggleButton = Create("TextButton", {
        Name = "ToggleButton",
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -24, 0.5, -10),
        BackgroundColor3 = value and CONFIG.COLORS.ACCENT_BLUE or CONFIG.COLORS.TOGGLE_BG,
        BorderSizePixel = 0,
        Text = value and ICONS.CHECK or "",
        TextColor3 = CONFIG.COLORS.TEXT_PRIMARY,
        TextSize = 12,
        Font = CONFIG.FONTS.SUBTITLE,
        Parent = ToggleFrame,
    })
    CreateCorner(ToggleButton, 4)
    
    local function UpdateToggle()
        value = not value
        Tween(ToggleButton, {
            BackgroundColor3 = value and CONFIG.COLORS.ACCENT_BLUE or CONFIG.COLORS.TOGGLE_BG
        })
        ToggleButton.Text = value and ICONS.CHECK or ""
        callback(value)
    end
    
    ToggleButton.MouseButton1Click:Connect(UpdateToggle)
    
    return ToggleFrame, function() return value end
end

