-- NOTIFICATION FUNCTION
-- ═══════════════════════════════════════════════════════════════════════════════

local function Notify(title, message, duration)
    duration = duration or 3
    
    local NotifGui = Create("ScreenGui", {
        Name = "Notification",
        Parent = LocalPlayer:WaitForChild("PlayerGui"),
        ResetOnSpawn = false,
    })
    
    local NotifFrame = Create("Frame", {
        Name = "Frame",
        Size = UDim2.new(0, 280, 0, 60),
        Position = UDim2.new(1, 20, 1, -80),
        BackgroundColor3 = CONFIG.COLORS.SIDEBAR_BG,
        BorderSizePixel = 0,
        Parent = NotifGui,
    })
    CreateCorner(NotifFrame, 6)
    
    Create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = CONFIG.COLORS.TEXT_PRIMARY,
        TextSize = CONFIG.TEXT_SIZES.REGULAR,
        Font = CONFIG.FONTS.SUBTITLE,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = NotifFrame,
    })
    
    Create("TextLabel", {
        Name = "Message",
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.new(0, 12, 0, 26),
        BackgroundTransparency = 1,
        Text = message,
        TextColor3 = CONFIG.COLORS.TEXT_SECONDARY,
        TextSize = CONFIG.TEXT_SIZES.SMALL,
        Font = CONFIG.FONTS.SMALL,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = NotifFrame,
    })
    
    Tween(NotifFrame, {Position = UDim2.new(1, -300, 1, -80)}, 0.3)
    
    task.delay(duration, function()
        Tween(NotifFrame, {Position = UDim2.new(1, 20, 1, -80)}, 0.3).Completed:Wait()
        NotifGui:Destroy()
    end)
end

